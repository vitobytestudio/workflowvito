{
	"name": "instagram-mcp-template",
	"version": "1.0.0",
	"description": "Instagram MCP Server on Cloudflare Workers - يعطي للوكيل أيدي وأعين للتحكم في إنستغرام عبر MCP",
	"cloudflare": {
		"label": "Instagram MCP Server",
		"products": ["Workers"],
		"categories": ["ai", "social"],
		"icon_urls": ["https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"],
