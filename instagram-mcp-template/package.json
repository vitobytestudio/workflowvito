		"publish": true
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "tsc --noEmit && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --port 8788",
		"start": "wrangler dev --port 8788"
	},
	"dependencies": {
		"hono": "4.11.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
